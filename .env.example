ASR_API_KEY=replace-with-your-openrouter-api-key
ASR_BASE_URL=https://openrouter.ai/api/v1
ASR_MODEL=qwen/qwen3-asr-flash
ASR_TIMEOUT_SECONDS=30
ASR_MAX_CONCURRENT_REQUESTS=4

POLISH_ENABLED=true
POLISH_API_KEY=replace-with-your-openai-compatible-api-key
POLISH_BASE_URL=https://api.openai.com/v1
POLISH_MODEL=gpt-4.1-mini
# Polishing makes one plain-text model call; failures safely return the merged ASR transcript.
# DeepSeek polishing always sends thinking.type=disabled. For Qwen, uncomment to send enable_thinking=false.
# POLISH_ENABLE_THINKING=false
POLISH_TEMPERATURE=0.1
POLISH_MAX_TOKENS=1500
POLISH_TIMEOUT_SECONDS=15
POLISH_MAX_RETRIES=0

SERVER_HOST=127.0.0.1
SERVER_PORT=9100
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVICE_TOKEN=
STATIC_ROOT=

FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=26214400
STT_SEGMENT_TARGET_SECONDS=30
STT_SEGMENT_MAX_SECONDS=45
STT_SEGMENT_OVERLAP_MS=1000
STT_SEGMENT_SILENCE_MS=600
STT_SEGMENT_MAX_IN_FLIGHT=2
STT_SEGMENT_MAX_RETRIES=2
STT_REQUEST_TIMEOUT_SECONDS=30
STT_FINALIZATION_TIMEOUT_SECONDS=120
STT_MAX_DURATION_SECONDS=600
STT_MAX_ACTIVE_SESSIONS=10
