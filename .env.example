# Provider credentials
ASR_PROVIDER=dashscope
ASR_API_KEY=
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
ASR_TIMEOUT_SECONDS=30

# qwen-audio-3.0-asr-flash is the model-market name; filetrans is its recording-file service ID.
# The filetrans API accepts inline WAV data, so no temporary OSS upload is required.

# OpenRouter ASR example:
# ASR_PROVIDER=openrouter
# ASR_API_KEY=replace-with-your-openrouter-api-key
# ASR_BASE_URL=https://openrouter.ai/api/v1
# ASR_MODEL=qwen/qwen3-asr-flash

# SiliconFlow FunAudioLLM SenseVoiceSmall example:
# ASR_PROVIDER=siliconflow
# ASR_API_KEY=replace-with-your-siliconflow-api-key
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall

POLISH_ENABLED=true
POLISH_API_KEY=replace-with-your-openai-compatible-api-key
POLISH_BASE_URL=https://api.openai.com/v1
POLISH_MODEL=gpt-4.1-mini
# DeepSeek requests always send thinking.type=disabled. Qwen can additionally use:
# POLISH_ENABLE_THINKING=false
POLISH_TEMPERATURE=0.1
POLISH_MAX_TOKENS=1500
POLISH_TIMEOUT_SECONDS=15
POLISH_MAX_RETRIES=0

# HTTP server and browser origins
SERVER_HOST=127.0.0.1
SERVER_PORT=9100
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVICE_TOKEN=
STATIC_ROOT=
METRICS_ENABLED=true
# Tests only. Never enable the deterministic mock providers in production.
MOCK_PROVIDERS_ENABLED=false
# Optional test-only stage overrides. When omitted, MOCK_PROVIDERS_ENABLED controls both stages.
# MOCK_ASR_ENABLED=true
# MOCK_POLISH_ENABLED=false
# MOCK_ASR_TEXT_FILE=/load-fixtures/polish-180s.txt
MOCK_PROVIDER_DELAY_MS=10

# Browser-safe anonymous authentication. Enable this in public production deployments.
ANONYMOUS_TOKENS_ENABLED=false
ANONYMOUS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ANONYMOUS_TOKEN_TTL_SECONDS=600
ANONYMOUS_TOKEN_ISSUE_LIMIT_PER_MINUTE=10
ANONYMOUS_MAX_ACTIVE_SESSIONS=2
ANONYMOUS_SESSION_START_LIMIT_PER_MINUTE=10
# Only these proxy addresses may supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Redis is optional for one instance and required for a multi-instance deployment.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=lili_voice_input
REDIS_LEASE_TTL_SECONDS=720
REDIS_PROVIDER_LEASE_TTL_SECONDS=60

# Audio conversion
FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=30
FFMPEG_MAX_CONCURRENCY=2
FFMPEG_QUEUE_SIZE=8
FFMPEG_QUEUE_TIMEOUT_SECONDS=5
MAX_UPLOAD_BYTES=26214400

# Streaming segmentation and ASR scheduler
STT_SEGMENT_TARGET_SECONDS=20
STT_SEGMENT_MAX_SECONDS=30
STT_SEGMENT_OVERLAP_SECONDS=1
STT_SEGMENT_SILENCE_MS=600
STT_SEGMENT_MAX_IN_FLIGHT=2
STT_SEGMENT_MAX_RETRIES=2
STT_MAX_CONCURRENCY=5
STT_ASR_QUEUE_SIZE=12
STT_ASR_QUEUE_TIMEOUT_SECONDS=10
STT_ASR_GLOBAL_CONCURRENCY=20
STT_REQUEST_TIMEOUT_SECONDS=30
STT_FINALIZATION_TIMEOUT_SECONDS=120
STT_MAX_DURATION_SECONDS=600

# Current single-instance candidate; revalidate it when the provider or model changes.
STT_MAX_ACTIVE_SESSIONS=5
STT_GLOBAL_ACTIVE_SESSIONS=100
STT_START_TIMEOUT_SECONDS=5
STT_IDLE_TIMEOUT_SECONDS=15
STT_SESSION_WALL_TIMEOUT_SECONDS=660
STT_ADMISSION_QUEUE_SIZE=20
STT_ADMISSION_WAIT_SECONDS=5

# Text polishing scheduler
POLISH_LOCAL_CONCURRENCY=5
POLISH_GLOBAL_CONCURRENCY=20
POLISH_QUEUE_SIZE=12
POLISH_QUEUE_TIMEOUT_SECONDS=3
